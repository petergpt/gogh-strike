  "application": {
    "format": "Each non-comment target line is zero-based original base.obj vertexIndex dx dy dz. The delta is in original MakeHuman coordinate units.",
    "operation": "For each source vertex, position = basePosition + sum(weight * targetDelta). Preserve original indices while applying targets; only then extract/reindex/transform the head. Recompute vertex normals after the final deformation.",
    "morphFamilies": "Choose one sex/age macro endpoint or a convex weighted blend of the young and old endpoints; do not add both endpoints at full weight. Local head/eye/cheek/chin/nose targets are additional deltas.",
    "loaderReference": "https://github.com/makehumancommunity/makehuman/blob/a8bc2d54ff0ac92e78ff71431b1023eda42bf482/makehuman/core/algos3d.py#L126-L145",
    "applyReference": "https://github.com/makehumancommunity/makehuman/blob/a8bc2d54ff0ac92e78ff71431b1023eda42bf482/makehuman/core/algos3d.py#L242-L284",
    "ageReference": "https://github.com/makehumancommunity/makehuman/blob/a8bc2d54ff0ac92e78ff71431b1023eda42bf482/makehuman/apps/human.py",
    "headLocalTargets": "head-age-incr, head-fat, head shape, paired cheek and eye fold/bag controls, chin width, nose scale/hump. Use modest local weights and inspect the result.",
    "ageBlend": {
      "youngEndpointYears": 25,
      "oldEndpointYears": 90,
      "range": "25 to 90 years",
      "formula": "oldWeight = (ageYears - 25) / 65; youngWeight = 1 - oldWeight. Blend matching-sex macro deltas from the original base.",
      "exampleMorisot47": {
        "youngWeight": 0.6615384615384615,
        "oldWeight": 0.3384615384615385
      },
      "note": "For the 24-year-old roster member, the downloaded young endpoint is a close adult starting shape; this subset omits child targets. head-age-incr is a separate artistic detail target, not a replacement for the macro age blend.",
      "source": "https://github.com/makehumancommunity/makehuman/blob/a8bc2d54ff0ac92e78ff71431b1023eda42bf482/makehuman/apps/human.py#L564-L600"
    }
  },
